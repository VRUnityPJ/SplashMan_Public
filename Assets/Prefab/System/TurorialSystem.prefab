    _text: "\u30C8\u30EA\u30AC\u30FC\u3092\u62BC\u3057\u306A\u304C\u3089\u30DC\u30C8\u30EB\u3092\u632F\u308B\u3068\u3001\u70AD\u9178\u30B2\u30FC\u30B8\u304C\u305F\u307E\u308B\uFF01\n\u30B2\u30FC\u30B8\u304C\u9AD8\u3044\u307B\u3069\u3001\u653B\u6483\u306E\u5A01\u529B\u3068\u7BC4\u56F2\u304C\u30A2\u30C3\u30D7\uFF01\n\u30B2\u30FC\u30B8\u3092\u534A\u5206\u4EE5\u4E0A\u305F\u3081\u3066\u307F\u3088\u3046"
  _practicePage:
    _image: {fileID: 0}
    _text: "\u6575\u306E\u65B9\u3092\u5411\u3044\u3066\u3001\u30C8\u30EA\u30AC\u30FC\u3092\u96E2\u3057\u3066\u8155\u3092\u632F\u308B\u3068\u30DC\u30C8\u30EB\u3092\u6295\u3052\u308B\uFF01\n\u6575\u3092\u5012\u3057\u3066\u307F\u3088\u3046"
  _scorePage:
    _image: {fileID: 0}
    _text: "\u5236\u9650\u6642\u9593\u5185\u306B\u6575\u3092\u305F\u304F\u3055\u3093\u5012\u3057\u3066\u30B9\u30B3\u30A2\u3092\u304B\u305B\u3054\u3046\uFF01\n\u6575\u306B\u8FD1\u3065\u304B\u308C\u308B\u3068\u30B9\u30B3\u30A2\u304C\u6E1B\u3063\u3066\u3057\u307E\u3046\u305E\n\u6E96\u5099\u304C\u3067\u304D\u305F\u3089\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u30B2\u30FC\u30E0\u30B9\u30BF\u30FC\u30C8\uFF01"
